---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Ayush Neekhar"
  description="Software Development Engineer 2 focused on mobile frontend and pragmatic product delivery."
  ogUrl="https://neekhar.dev"
>
  <main class="container">
    <header class="top-bar">
      <div class="logo">NEEKHAR<span>.DEV</span></div>
      <div class="controls">
        <button class="theme-toggle" type="button" aria-label="Toggle color theme">
          <svg class="icon icon--sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <line x1="12" y1="2" x2="12" y2="4"></line>
            <line x1="12" y1="20" x2="12" y2="22"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="2" y1="12" x2="4" y2="12"></line>
            <line x1="20" y1="12" x2="22" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg class="icon icon--moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 12.79A9 9 0 0111.21 3 7 7 0 1021 12.79z"></path>
          </svg>
        </button>
      </div>
    </header>

    <div class="bento-grid">
      <!-- HERO (1) -->
      <section class="bento-item hero-card">
        <h1>BUILDING<br/>STUFF<br/>THAT WORKS.</h1>
        <p class="subtitle">Software Development Engineer 2</p>
        <p class="bio">
          Software Development Engineer 2 focused on mobile frontend, React Native, and pragmatic full-stack delivery. Currently building reimbursement experiences at <span class="highlight">Rippling</span> across mobile and app surfaces, with some smaller backend ownership where needed. I care about performance, testing, clean architecture, and building products that feel fast, useful, and durable.
        </p>
      </section>

      <!-- PROTI PROJECT (2) -->
      <section class="bento-item proti-card">
        <div class="card-header">
          <h2>FEATURED PROJECT</h2>
          <span class="status-badge">LIVE</span>
        </div>
        <div class="proti-content">
          <h3>PROTI</h3>
          <p>A minimal, lightning-fast pastebin with syntax highlighting.</p>
          <div class="tech-stack">
            <span>Astro</span>
            <span>CodeMirror</span>
            <span>Cloudflare</span>
          </div>
        </div>
        <div class="card-actions">
          <a href="https://paste.neekhar.dev" class="brutal-btn primary">
            Launch App
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
          </a>
          <a href="https://github.com/ayushneekhar/proti" target="_blank" rel="noreferrer" class="brutal-btn secondary">
            Source Code
          </a>
        </div>
      </section>

      <!-- STATUS TICKER REPLACEMENT (3) -->
      <section class="bento-item status-card">
        <div class="blinking-dot"></div>
        <div class="status-text">
          <p><strong>CURRENTLY:</strong> Owning reimbursement frontend across mobile and app at Rippling, plus the occasional backend task when the feature needs it.</p>
        </div>
      </section>

      <!-- SOCIALS (4) -->
      <section class="bento-item socials-card">
        <a href="https://github.com/ayushneekhar" target="_blank" rel="noreferrer" class="social-link" aria-label="GitHub">
          <svg viewBox="0 0 24 24" width="32" height="32" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
        </a>
        <a href="https://www.linkedin.com/in/ayushneekhar" target="_blank" rel="noreferrer" class="social-link" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" width="32" height="32" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
        <a href="mailto:a.neekhar01@gmail.com" class="social-link" aria-label="Email">
          <svg viewBox="0 0 24 24" width="32" height="32" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        </a>
      </section>

      <!-- RESUME BUTTON (5) -->
      <a href="https://drive.google.com/file/d/1oWaDxkSHn4Pxa2xQZnmvL0FhfevVled2/view?usp=sharing" target="_blank" rel="noreferrer" class="bento-item resume-card">
        <svg viewBox="0 0 24 24" width="32" height="32" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="resume-icon"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        <span>RÉSUMÉ</span>
      </a>

      <!-- EXPERIENCE (6) -->
      <section class="bento-item experience-card">
        <h2>EXPERIENCE</h2>
        <div class="exp-list">
          <div class="exp-item">
            <div class="exp-header">
              <h3>RIPPLING</h3>
              <span class="exp-date">Present</span>
            </div>
            <p class="exp-role">SDE 2</p>
            <p class="exp-detail">Owning reimbursement experiences across mobile and app surfaces, shipping frontend work end-to-end and picking up smaller backend tasks when features cross service boundaries.</p>
            <p class="exp-detail exp-tech">React Native · Frontend Architecture · Product UI · APIs · Backend Integrations · Testing · Performance</p>
          </div>
          <div class="exp-item">
            <div class="exp-header">
              <h3>BAJAJ FINSERV HEALTH</h3>
              <span class="exp-date">Oct 22 — Oct 24</span>
            </div>
            <p class="exp-role">SDE · Pune</p>
            <p class="exp-detail">Shipped high-impact React Native features with measurable revenue impact, integrated Bluetooth glucometer data, and built native iOS capabilities (HealthKit SDK in Swift) while expanding platform integrations like Fitpass and CleverTap.</p>
            <p class="exp-detail exp-tech">React Native · Swift · Kotlin/Java · Native Modules · Xcode · Android Studio · Jest/Detox · App Store / Play Store releases</p>
          </div>
        </div>
      </section>

      <!-- OTHER PROJECTS (7) -->
      <section class="bento-item other-projects-card">
        <h2>OTHER WORKS</h2>
        <div class="other-projects-list">
          <a href="https://github.com/ayushneekhar/Apex" target="_blank" rel="noreferrer" class="other-project">
            <div class="op-header">
              <h3>Apex</h3>
              <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
            </div>
            <p>A no-BS workout tracker focused on fast logging, clean UX, and a practical mobile experience without the usual bloat.</p>
          </a>
          <a href="https://github.com/ayushneekhar/rn-turbo-secure-storage" target="_blank" rel="noreferrer" class="other-project">
            <div class="op-header">
              <h3>rn-turbo-secure-storage</h3>
              <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
            </div>
            <p>New-arch secure storage primitives for React Native with Kotlin + TurboModules.</p>
          </a>
          <a href="https://github.com/ayushneekhar/WiproGoodWid" target="_blank" rel="noreferrer" class="other-project">
            <div class="op-header">
              <h3>WiproGoodWid</h3>
              <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
            </div>
            <p>App to control Tuya IoT smart bulbs through your phone.</p>
          </a>
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 32px 24px 96px;
    display: flex;
    flex-direction: column;
    gap: 48px;
    font-family: var(--font-mono);
  }

  /* Top Bar */
  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: var(--brutal-border);
    background: var(--surface);
    padding: 16px 24px;
    box-shadow: var(--brutal-shadow);
  }

  .logo {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -1px;
  }

  .logo span {
    color: var(--accent);
  }

  /* Bento Grid Layout */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: minmax(100px, auto);
    gap: 24px;
  }

  .bento-item {
    background: var(--surface);
    border: var(--brutal-border);
    box-shadow: var(--brutal-shadow);
    padding: 32px;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  /* Common Item Hover */
  a.bento-item:hover,
  .social-link:hover,
  .other-project:hover {
    transform: translate(4px, 4px);
    box-shadow: var(--brutal-shadow-hover);
  }

  /* 1. Hero Card */
  .hero-card {
    grid-column: span 2;
    grid-row: span 2;
    justify-content: center;
    background: var(--surface);
  }

  .hero-card h1 {
    font-size: clamp(3rem, 5vw, 4.5rem);
    line-height: 0.9;
    letter-spacing: -2px;
    margin-bottom: 24px;
  }

  .subtitle {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent);
    margin: 0 0 16px 0;
    text-transform: uppercase;
  }

  .bio {
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 0;
    color: var(--text);
  }

  .bio .highlight {
    font-weight: 700;
    background: var(--text);
    color: var(--bg);
    padding: 0 4px;
  }

  /* 2. Proti Card */
  .proti-card {
    grid-column: span 2;
    grid-row: span 2;
    background: var(--proti-bg);
    color: var(--proti-text);
    border-color: var(--outline);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: auto;
  }

  .card-header h2 {
    font-size: 1.2rem;
    color: var(--accent);
  }

  .status-badge {
    background: var(--accent);
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-weight: 700;
    padding: 4px 12px;
    font-size: 0.85rem;
    border: 2px solid var(--text);
  }

  .proti-content {
    margin: 32px 0;
  }

  .proti-content h3 {
    font-size: 4rem;
    line-height: 1;
    letter-spacing: -2px;
    margin-bottom: 16px;
  }

  .proti-content p {
    font-size: 1.2rem;
    margin: 0 0 24px 0;
    line-height: 1.5;
  }

  .tech-stack {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .tech-stack span {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 6px 12px;
    border: 2px solid currentColor;
    text-transform: uppercase;
  }

  .card-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .brutal-btn {
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    padding: 12px 24px;
    border: 4px solid var(--proti-text);
    box-shadow: 6px 6px 0px 0px var(--proti-text);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.15s;
    cursor: pointer;
  }

  .brutal-btn:hover {
    transform: translate(2px, 2px);
    box-shadow: 4px 4px 0px 0px var(--proti-text);
  }

  .brutal-btn.primary {
    background: var(--accent);
    color: var(--accent-text);
  }

  .brutal-btn.primary:hover {
    background: var(--proti-text);
    color: var(--proti-bg);
  }

  .brutal-btn.secondary {
    background: transparent;
    color: var(--proti-text);
  }

  .brutal-btn.secondary:hover {
    background: var(--proti-text);
    color: var(--proti-bg);
  }

  /* 3. Status Card */
  .status-card {
    grid-column: span 2;
    flex-direction: row;
    align-items: center;
    gap: 16px;
    padding: 24px 32px;
  }

  .blinking-dot {
    width: 16px;
    height: 16px;
    background-color: var(--accent);
    border-radius: 50%;
    flex-shrink: 0;
    animation: blink 1.5s infinite ease-in-out;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .status-text p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* 4. Socials Card */
  .socials-card {
    grid-column: span 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 24px;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background: var(--surface);
    border: var(--brutal-border);
    box-shadow: 4px 4px 0px 0px var(--outline);
    color: var(--text);
    transition: all 0.15s;
  }

  .social-link:hover {
    background: var(--accent);
    color: var(--bg);
    box-shadow: 2px 2px 0px 0px var(--outline);
  }

  /* 5. Resume Card */
  .resume-card {
    grid-column: span 1;
    background: var(--accent);
    color: var(--accent-text);
    border-color: var(--text);
    justify-content: center;
    align-items: center;
    gap: 12px;
    padding: 24px;
    text-decoration: none;
  }

  .resume-card span {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.2rem;
  }

  .resume-card:hover {
    background: var(--text);
    color: var(--bg);
    border-color: var(--accent);
  }

  /* 6. Experience */
  .experience-card {
    grid-column: span 2;
    grid-row: span 2;
  }

  .experience-card h2 {
    font-size: 2rem;
    margin-bottom: 32px;
    border-bottom: 4px solid var(--text);
    padding-bottom: 8px;
    display: inline-block;
  }

  .exp-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .exp-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .exp-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
  }

  .exp-header h3 {
    font-size: 1.5rem;
  }

  .exp-date {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9rem;
    background: var(--text);
    color: var(--bg);
    padding: 4px 8px;
  }

  .exp-role {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent);
  }

  .exp-detail {
    margin: 8px 0 0 0;
    line-height: 1.5;
  }

  .exp-tech {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.6;
  }

  /* 7. Other Projects */
  .other-projects-card {
    grid-column: span 2;
    grid-row: span 2;
  }

  .other-projects-card h2 {
    font-size: 2rem;
    margin-bottom: 32px;
    border-bottom: 4px solid var(--text);
    padding-bottom: 8px;
    display: inline-block;
  }

  .other-projects-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
    height: 100%;
  }

  .other-project {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border: var(--brutal-border);
    box-shadow: 4px 4px 0px 0px var(--outline);
    background: var(--bg);
    transition: all 0.15s;
    flex: 1;
  }

  .other-project:hover {
    background: var(--surface);
    box-shadow: 2px 2px 0px 0px var(--outline);
  }

  .op-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .op-header h3 {
    font-size: 1.2rem;
  }

  .op-header svg {
    color: var(--accent);
  }

  .other-project p {
    margin: 0;
    line-height: 1.5;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    
    .socials-card, .resume-card {
      grid-column: span 1;
    }
  }

  @media (max-width: 768px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }
    
    .hero-card, .proti-card, .status-card, .experience-card, .other-projects-card, .socials-card, .resume-card {
      grid-column: span 1;
    }

    .proti-content h3 {
      font-size: 3rem;
    }
  }
</style>

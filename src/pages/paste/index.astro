        return autocompletion({ override: [jsCompletionSource] });
      case 'python':
        return autocompletion({ override: [pythonCompletionSource] });
      default:
        return autocompletion();
    }
  }

  // Light theme
  const lightTheme = EditorView.theme({
    '&': {
      backgroundColor: 'var(--surface-tint)',
      color: 'var(--text)',
    },
    '.cm-content': {
      caretColor: 'var(--accent)',
      fontFamily: 'var(--font-family)',
      fontSize: '0.9rem',
      lineHeight: '1.6',
    },
    '.cm-cursor': {
      borderLeftColor: 'var(--accent)',
    },
    '.cm-gutters': {
      backgroundColor: 'var(--surface)',
      color: 'var(--muted)',
      borderRight: '1px solid var(--outline)',
      fontFamily: 'var(--font-family)',
      fontSize: '0.9rem',
    },
    '.cm-lineNumbers .cm-gutterElement': {
      padding: '0 16px',
      minWidth: '50px',
      textAlign: 'center',
    },
    '.cm-activeLineGutter': {
      backgroundColor: 'var(--surface-tint)',
    },
    '.cm-activeLine': {
      backgroundColor: 'rgba(0, 0, 0, 0.04)',
    },
    '.cm-selectionBackground': {
      backgroundColor: 'rgba(79, 70, 229, 0.2) !important',
    },
    '&.cm-focused .cm-selectionBackground': {
      backgroundColor: 'rgba(79, 70, 229, 0.3) !important',
    },
    '.cm-matchingBracket': {
      backgroundColor: 'rgba(79, 70, 229, 0.3)',
      outline: '1px solid rgba(79, 70, 229, 0.5)',
    },
    '.cm-foldGutter': {
      width: '16px',
    },
    '.cm-tooltip': {
      backgroundColor: 'var(--surface)',
      border: '1px solid var(--outline)',
      borderRadius: '6px',
    },
    '.cm-tooltip-autocomplete': {
      '& > ul > li': {
        padding: '4px 8px',
      },
      '& > ul > li[aria-selected]': {
        backgroundColor: 'var(--accent)',
        color: 'var(--bg)',
      },
    },
  }, { dark: false });

  // Dark theme extension
  const darkThemeExtension = [
    oneDark,
    EditorView.theme({
      '&': {
        backgroundColor: 'var(--surface-tint)',
      },
      '.cm-gutters': {
        backgroundColor: 'var(--surface)',
        color: 'var(--muted)',
        borderRight: '1px solid var(--outline)',
      },
      '.cm-activeLineGutter': {
        backgroundColor: 'var(--surface-tint)',
      },
      '.cm-activeLine': {
        backgroundColor: 'rgba(255, 255, 255, 0.04)',
      },
    }, { dark: true }),
  ];

  // Check current theme
  function isDarkMode() {
    return document.documentElement.dataset.theme === 'dark';
  }

  // Create editor
  const container = document.getElementById('editor-container')!;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;
  
  // Custom dropdown elements
  const languageDropdown = document.getElementById('language-dropdown')!;
  const languageTrigger = document.getElementById('language-trigger')!;
  const languageMenu = document.getElementById('language-menu')!;
  const languageValue = document.getElementById('language-value') as HTMLInputElement;
  const languageTriggerText = languageTrigger.querySelector('.language-trigger-text')!;
  
  // Get current language value
  function getSelectedLanguage() {
    return languageValue.value;
  }
  
  // Toggle dropdown
  function toggleDropdown(open?: boolean) {
    const isOpen = open ?? !languageDropdown.classList.contains('open');
    languageDropdown.classList.toggle('open', isOpen);
    languageTrigger.setAttribute('aria-expanded', String(isOpen));
    
    if (isOpen) {
      // Focus the selected option
      const selected = languageMenu.querySelector('[aria-selected="true"]') as HTMLElement;
      selected?.focus();
    }
  }
  
  // Close dropdown
  function closeDropdown() {
    toggleDropdown(false);
  }
  
  // Select language
  function selectLanguage(value: string, label: string) {
    languageValue.value = value;
    languageTriggerText.textContent = label;
    
    // Update aria-selected
    languageMenu.querySelectorAll('.language-option').forEach(opt => {
      opt.setAttribute('aria-selected', opt.getAttribute('data-value') === value ? 'true' : 'false');
    });
    
    closeDropdown();
    
    // Update editor
    editor.dispatch({
      effects: [
        languageCompartment.reconfigure(getLanguageExtension(value)),
        completionCompartment.reconfigure(getCompletionExtension(value)),
      ],
    });
    
    // Return focus to editor
    editor.focus();
  }
  
  // Dropdown trigger click
  languageTrigger.addEventListener('click', () => toggleDropdown());
  
  // Option click
  languageMenu.addEventListener('click', (e) => {
    const option = (e.target as HTMLElement).closest('.language-option') as HTMLElement;
    if (option) {
      selectLanguage(option.dataset.value!, option.textContent!);
    }
  });
  
  // Keyboard navigation
  languageTrigger.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowDown') {
      e.preventDefault();
      toggleDropdown(true);
    }
  });
  
  languageMenu.addEventListener('keydown', (e) => {
    const options = Array.from(languageMenu.querySelectorAll('.language-option')) as HTMLElement[];
    const currentIndex = options.findIndex(opt => opt === document.activeElement);
    
    switch (e.key) {
      case 'ArrowDown':
        e.preventDefault();
        options[(currentIndex + 1) % options.length]?.focus();
        break;
      case 'ArrowUp':
        e.preventDefault();
        options[(currentIndex - 1 + options.length) % options.length]?.focus();
        break;
      case 'Enter':
      case ' ':
        e.preventDefault();
        const focused = document.activeElement as HTMLElement;
        if (focused?.classList.contains('language-option')) {
          selectLanguage(focused.dataset.value!, focused.textContent!);
        }
        break;
      case 'Escape':
        e.preventDefault();
        closeDropdown();
        languageTrigger.focus();
        break;
      case 'Tab':
        closeDropdown();
        break;
    }
  });
  
  // Close on outside click
  document.addEventListener('click', (e) => {
    if (!languageDropdown.contains(e.target as Node)) {
      closeDropdown();
    }
  });

  const editor = new EditorView({
    state: EditorState.create({
      doc: '',
      extensions: [
        lineNumbers(),
        highlightActiveLineGutter(),
        highlightSpecialChars(),
        history(),
        foldGutter(),
        drawSelection(),
        dropCursor(),
        EditorState.allowMultipleSelections.of(true),
        indentOnInput(),
        syntaxHighlighting(defaultHighlightStyle, { fallback: true }),
        bracketMatching(),
        closeBrackets(),
        completionCompartment.of(getCompletionExtension(getSelectedLanguage())),
        rectangularSelection(),
        crosshairCursor(),
        highlightActiveLine(),
        indentUnit.of('  '),
        keymap.of([
          ...closeBracketsKeymap,
          ...defaultKeymap,
          ...historyKeymap,
          ...foldKeymap,
          ...completionKeymap,
          indentWithTab,
        ]),
        languageCompartment.of(getLanguageExtension(getSelectedLanguage())),
        themeCompartment.of(isDarkMode() ? darkThemeExtension : lightTheme),
        EditorView.lineWrapping,
        EditorView.contentAttributes.of({ 'aria-label': 'Code editor' }),
      ],
    }),
    parent: container,
  });

  // Focus editor
  editor.focus();

  // Theme change observer
  const themeObserver = new MutationObserver(() => {
    editor.dispatch({
      effects: themeCompartment.reconfigure(isDarkMode() ? darkThemeExtension : lightTheme),
    });
  });
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  // Save handler
  saveBtn.addEventListener('click', async () => {
    const content = editor.state.doc.toString().trim();
    if (!content) {
      alert('Please enter some content');
      return;
    }

    saveBtn.disabled = true;
    const btnText = saveBtn.querySelector('.btn-text');
    if (btnText) btnText.textContent = 'Saving...';

    try {
      const response = await fetch('/api/paste', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          content,
          language: getSelectedLanguage(),
        }),
      });

      if (!response.ok) {
        throw new Error('Failed to save paste');
      }

      const data = await response.json();
      window.location.href = `/paste/${data.id}`;
    } catch (error) {
      alert('Failed to save paste. Please try again.');
      saveBtn.disabled = false;
      if (btnText) btnText.textContent = 'Save';
    }
  });

  // Keyboard shortcut: Ctrl/Cmd+S to save
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 's') {
      e.preventDefault();
      saveBtn.click();
    }
  });
</script>

<style>

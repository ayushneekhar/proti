    const isOpen = open ?? !languageDropdown.classList.contains('open');
    languageDropdown.classList.toggle('open', isOpen);
    languageTrigger.setAttribute('aria-expanded', String(isOpen));
    
    if (isOpen) {
      // Focus the selected option
      const selected = languageMenu.querySelector('[aria-selected="true"]') as HTMLElement;
      selected?.focus();
    }
  }
  
  // Close dropdown
  function closeDropdown() {
    toggleDropdown(false);
  }
  
  // Select language
  function selectLanguage(value: string, label: string) {
    languageValue.value = value;
    languageTriggerText.textContent = label;
    
    // Update aria-selected
    languageMenu.querySelectorAll('.language-option').forEach(opt => {
      opt.setAttribute('aria-selected', opt.getAttribute('data-value') === value ? 'true' : 'false');
    });
    
    closeDropdown();
    
    // Update editor
    editor.dispatch({
      effects: [
        languageCompartment.reconfigure(getLanguageExtension(value)),
        completionCompartment.reconfigure(getCompletionExtension(value)),
      ],
    });
    
    // Update language-specific UI
    updateLanguageUI(value);
    
    // Return focus to editor
    editor.focus();
  }
  

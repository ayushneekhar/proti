    white-space: nowrap;
  }

  .brand:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .brand svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }

  .separator {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .page-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text);
  }

  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Custom Language Dropdown */
  .language-dropdown {
    position: relative;
  }

  .language-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-family);
    font-size: 0.8rem;
    padding: 6px 10px;
    border: 1px solid var(--outline);
    border-radius: 6px;
    background-color: var(--surface-tint);
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
    min-width: 100px;
    justify-content: space-between;
  }

  .language-trigger:hover,
  .language-trigger:focus {
    border-color: var(--accent);
    outline: none;
  }

  .language-dropdown.open .language-trigger {
    border-color: var(--accent);
    background-color: var(--surface);
  }

  .dropdown-chevron {
    width: 12px;
    height: 12px;
    stroke: var(--muted);
    stroke-width: 2;
    fill: none;
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .language-dropdown.open .dropdown-chevron {
    transform: rotate(180deg);
  }

  .language-menu {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    min-width: 140px;
    max-height: 280px;
    overflow-y: auto;
    background-color: var(--surface);
    border: 1px solid var(--outline);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
    z-index: 100;
    padding: 4px;
  }

  :root[data-theme="dark"] .language-menu {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .language-dropdown.open .language-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .language-option {
    display: block;
    width: 100%;
    padding: 8px 12px;
    font-family: var(--font-family);
    font-size: 0.8rem;
    text-align: left;
    color: var(--text);
    background: none;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.1s ease, color 0.1s ease;
  }

  .language-option:hover,
  .language-option:focus {
    background-color: var(--surface-tint);
    outline: none;
  }

  .language-option[aria-selected="true"] {
    color: var(--accent);
    font-weight: 700;
  }

  .language-option[aria-selected="true"]::before {
    content: "✓ ";
  }

  /* Scrollbar styling for dropdown */
  .language-menu::-webkit-scrollbar {
    width: 6px;
  }

  .language-menu::-webkit-scrollbar-track {
    background: transparent;
  }

  .language-menu::-webkit-scrollbar-thumb {
    background-color: var(--outline);
    border-radius: 3px;
  }

  .language-menu::-webkit-scrollbar-thumb:hover {
    background-color: var(--muted);
  }

  .save-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    font-family: var(--font-family);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--bg);
    background-color: var(--accent);
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .save-btn:hover:not(:disabled) {
    opacity: 0.9;
  }

  .save-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .save-btn svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }

  .editor-container {
    flex: 1;
    overflow: hidden;
  }

  /* CodeMirror full height */
  .editor-container :global(.cm-editor) {
    height: 100%;
  }

  .editor-container :global(.cm-scroller) {
    overflow: auto;
    position: relative;
  }


  /* Mobile adjustments */
  @media (max-width: 640px) {
    .toolbar {
      padding: 0 12px;
      height: 44px;
      min-height: 44px;
    }

    .brand span {
      display: none;
    }

    .separator {
      display: none;
    }

    .page-title {
      font-size: 0.9rem;
    }

    .language-trigger {
      min-width: 80px;
      padding: 5px 8px;
      font-size: 0.75rem;
    }

    .language-menu {
      min-width: 120px;
      right: 0;
      left: auto;
    }

    .btn-text {
      display: none;
    }

    .save-btn {
      padding: 6px 8px;
    }
  }
</style>

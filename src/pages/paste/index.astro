---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Paste | Proti"
  description="Create and share code snippets with syntax highlighting. Supports JavaScript, TypeScript, Python, and more."
  ogUrl="https://paste.neekhar.dev"
>
  <div class="paste-app">
    <header class="toolbar">
      <div class="toolbar-left">
        <a href="https://neekhar.dev" class="brand">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span>neekhar.dev</span>
        </a>
        <span class="separator">/</span>
        <span class="page-title">paste</span>
      </div>
      <div class="toolbar-right">
        <div class="language-dropdown" id="language-dropdown">
          <button 
            type="button" 
            class="language-trigger" 
            id="language-trigger"
            aria-haspopup="listbox"
            aria-expanded="false"
          >
            <span class="language-trigger-text">JavaScript</span>
            <svg class="dropdown-chevron" viewBox="0 0 24 24" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="language-menu" id="language-menu" role="listbox" aria-label="Select language">
            <button type="button" class="language-option" data-value="javascript" role="option" aria-selected="true">JavaScript</button>
            <button type="button" class="language-option" data-value="typescript" role="option">TypeScript</button>
            <button type="button" class="language-option" data-value="python" role="option">Python</button>
            <button type="button" class="language-option" data-value="rust" role="option">Rust</button>
            <button type="button" class="language-option" data-value="go" role="option">Go</button>
            <button type="button" class="language-option" data-value="html" role="option">HTML</button>
            <button type="button" class="language-option" data-value="css" role="option">CSS</button>
            <button type="button" class="language-option" data-value="json" role="option">JSON</button>
            <button type="button" class="language-option" data-value="markdown" role="option">Markdown</button>
            <button type="button" class="language-option" data-value="sql" role="option">SQL</button>
            <button type="button" class="language-option" data-value="shell" role="option">Shell</button>
            <button type="button" class="language-option" data-value="yaml" role="option">YAML</button>
            <button type="button" class="language-option" data-value="cpp" role="option">C++</button>
            <button type="button" class="language-option" data-value="java" role="option">Java</button>
            <button type="button" class="language-option" data-value="plaintext" role="option">Plain Text</button>
          </div>
        </div>
        <input type="hidden" id="language-value" value="javascript" />
        
        <!-- Markdown Preview Toggle (hidden by default) -->
        <button id="md-preview-btn" class="tool-btn with-tooltip hidden" type="button" data-tooltip="Preview Markdown">
          <svg class="icon-edit" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"></path>
            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"></path>
          </svg>
          <svg class="icon-preview" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </button>
        
        <!-- JSON Tools (hidden by default) -->
        <div id="json-tools" class="json-tools hidden">
          <button id="json-format-btn" class="tool-btn with-tooltip" type="button" data-tooltip="Format JSON">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <line x1="21" y1="10" x2="3" y2="10"></line>
              <line x1="21" y1="6" x2="3" y2="6"></line>
              <line x1="21" y1="14" x2="3" y2="14"></line>
              <line x1="21" y1="18" x2="3" y2="18"></line>
            </svg>
          </button>
        </div>
        
        <button class="theme-toggle" type="button" aria-label="Toggle color theme">
          <svg class="icon icon--sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <line x1="12" y1="2" x2="12" y2="4"></line>
            <line x1="12" y1="20" x2="12" y2="22"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="2" y1="12" x2="4" y2="12"></line>
            <line x1="20" y1="12" x2="22" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg class="icon icon--moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 12.79A9 9 0 0111.21 3 7 7 0 1021 12.79z"></path>
          </svg>
        </button>
        <!-- Options button that opens panel -->
        <button id="options-btn" class="tool-btn with-tooltip" type="button" data-tooltip="Paste options">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="1"></circle>
            <circle cx="19" cy="12" r="1"></circle>
            <circle cx="5" cy="12" r="1"></circle>
          </svg>
        </button>
        
        <button id="save-btn" class="save-btn">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"></path>
            <polyline points="17 21 17 13 7 13 7 21"></polyline>
            <polyline points="7 3 7 8 15 8"></polyline>
          </svg>
          <span class="btn-text">Save</span>
        </button>
      </div>
    </header>
    
    <!-- Options Panel (hidden by default) -->
    <div id="options-panel" class="options-panel hidden">
      <button id="options-close" class="options-close" type="button" aria-label="Close options">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div class="option-group">
        <label class="option-label">Expires in</label>
        <div class="expiration-options">
          <button type="button" class="expiration-btn" data-value="1h">1 hour</button>
          <button type="button" class="expiration-btn" data-value="1d">1 day</button>
          <button type="button" class="expiration-btn" data-value="7d">7 days</button>
          <button type="button" class="expiration-btn active" data-value="30d">30 days</button>
        </div>
      </div>
      <div class="option-group">
        <label class="option-label">
          <input type="checkbox" id="burn-toggle" />
          <span class="checkbox-custom"></span>
          Burn after reading
        </label>
        <span class="option-hint">Paste will be deleted after first view</span>
      </div>
      <div class="option-group">
        <label class="option-label">
          <input type="checkbox" id="password-toggle" />
          <span class="checkbox-custom"></span>
          Password protect
        </label>
        <input 
          type="password" 
          id="password-input" 
          class="password-input hidden" 
          placeholder="Enter password"
          autocomplete="new-password"
        />
      </div>
    </div>
    
    <div id="editor-container" class="editor-container"></div>
    <div id="markdown-preview" class="markdown-preview hidden"></div>
    
    <!-- Drag & Drop Overlay -->
    <div id="drop-overlay" class="drop-overlay hidden">
      <div class="drop-content">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
        <span>Drop file to paste</span>
      </div>
    </div>
    
    <!-- Toast notification -->
    <div id="toast" class="toast hidden"></div>
    
    <!-- Status Bar -->
    <footer class="status-bar">
      <div class="status-left">
        <a href="https://github.com/ayushneekhar" target="_blank" rel="noopener noreferrer" class="status-link">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22"></path>
          </svg>
          <span>GitHub</span>
        </a>
      </div>
      <div class="status-right">
        <span class="status-hint"><span class="mod-key">Ctrl</span>+S save · <span class="mod-key">Ctrl</span>+N new</span>
        <button id="about-btn" class="status-link" type="button">About</button>
      </div>
    </footer>
    
    <!-- About Modal -->
    <div id="about-modal" class="about-modal hidden">
      <div class="about-modal-content">
        <button id="about-close" class="about-close" aria-label="Close">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
        <div class="about-content" id="about-content">
          <div class="about-header">
            <h2>Paste</h2>
            <p class="about-tagline">An elegant pastebin service</p>
          </div>
          
          <p class="about-intro">Paste, save and share the link of your text content using a sleek and intuitive interface!</p>
          
          <div class="feature-grid">
            <div class="feature-section">
              <h3>Editor</h3>
              <ul>
                <li>Syntax highlighting for 15+ languages</li>
                <li>Dark and light themes</li>
                <li>Markdown rendering preview</li>
                <li>JSON formatting & validation</li>
                <li>Drag & drop file upload</li>
                <li>Language-aware autocomplete</li>
              </ul>
            </div>
            
            <div class="feature-section">
              <h3>Sharing</h3>
              <ul>
                <li>One-click URL copy</li>
                <li>QR code generation</li>
                <li>Line linking (<code>#L10-L20</code>)</li>
                <li>Fork & edit existing pastes</li>
                <li>Download as file</li>
              </ul>
            </div>
            
            <div class="feature-section">
              <h3>Privacy & Security</h3>
              <ul>
                <li>Password protection</li>
                <li>Burn after reading</li>
                <li>Custom expiration (1h, 1d, 7d, 30d)</li>
              </ul>
            </div>
            
            <div class="feature-section">
              <h3>Keyboard Shortcuts</h3>
              <ul class="shortcut-list">
                <li><kbd class="mod-key">Ctrl</kbd>+<kbd>S</kbd> <span>Save paste</span></li>
                <li><kbd class="mod-key">Ctrl</kbd>+<kbd>N</kbd> <span>New paste</span></li>
                <li><kbd class="mod-key">Ctrl</kbd>+<kbd>A</kbd> <span>Select all content</span></li>
              </ul>
            </div>
          </div>
          
          <div class="about-notice">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <p>Documents have explicit expiration times. However, documents may be removed at any time without notice.</p>
          </div>
          
          <div class="about-footer">
            <div class="about-links">
              <a href="https://github.com/ayushneekhar/proti" target="_blank" rel="noopener noreferrer" class="about-link">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22"></path>
                </svg>
                <span>Source Code</span>
              </a>
              <a href="https://neekhar.dev" target="_blank" rel="noopener noreferrer" class="about-link">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="2" y1="12" x2="22" y2="12"></line>
                  <path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"></path>
                </svg>
                <span>neekhar.dev</span>
              </a>
            </div>
            <p class="about-tech">Built with Astro & CodeMirror · Hosted on Cloudflare</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { EditorView, keymap, lineNumbers, highlightActiveLineGutter, highlightSpecialChars, drawSelection, dropCursor, rectangularSelection, crosshairCursor, highlightActiveLine, Decoration, type DecorationSet } from '@codemirror/view';
  import { EditorState, Compartment, StateField, StateEffect } from '@codemirror/state';
  import { indentOnInput, bracketMatching, foldGutter, foldKeymap, indentUnit, syntaxHighlighting, defaultHighlightStyle } from '@codemirror/language';
  import { defaultKeymap, history, historyKeymap, indentWithTab } from '@codemirror/commands';
  import { closeBrackets, closeBracketsKeymap, autocompletion, completionKeymap, type CompletionContext, type Completion } from '@codemirror/autocomplete';
  import { marked } from 'marked';
  import { javascript } from '@codemirror/lang-javascript';
  import { python } from '@codemirror/lang-python';
  import { html } from '@codemirror/lang-html';
  import { css } from '@codemirror/lang-css';
  import { json } from '@codemirror/lang-json';
  import { markdown } from '@codemirror/lang-markdown';
  import { sql } from '@codemirror/lang-sql';
  import { rust } from '@codemirror/lang-rust';
  import { cpp } from '@codemirror/lang-cpp';
  import { java } from '@codemirror/lang-java';
  import { yaml } from '@codemirror/lang-yaml';
  import { oneDark } from '@codemirror/theme-one-dark';

  // Detect platform and update modifier key display
  const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0 || 
                navigator.userAgent.toUpperCase().indexOf('MAC') >= 0;
  const modKey = isMac ? '⌘' : 'Ctrl';
  
  document.querySelectorAll('.mod-key').forEach(el => {
    el.textContent = modKey;
  });

  // Browser/JavaScript global completions
  const jsGlobals: Completion[] = [
    // Console
    { label: 'console', type: 'variable', info: 'Console object for logging' },
    { label: 'console.log', type: 'function', info: 'Log a message to the console', apply: 'console.log()' },
    { label: 'console.error', type: 'function', info: 'Log an error message', apply: 'console.error()' },
    { label: 'console.warn', type: 'function', info: 'Log a warning message', apply: 'console.warn()' },
    { label: 'console.info', type: 'function', info: 'Log an info message', apply: 'console.info()' },
    { label: 'console.table', type: 'function', info: 'Display tabular data', apply: 'console.table()' },
    { label: 'console.dir', type: 'function', info: 'Display object properties', apply: 'console.dir()' },
    { label: 'console.time', type: 'function', info: 'Start a timer', apply: 'console.time()' },
    { label: 'console.timeEnd', type: 'function', info: 'End a timer', apply: 'console.timeEnd()' },
    { label: 'console.group', type: 'function', info: 'Create a console group', apply: 'console.group()' },
    { label: 'console.groupEnd', type: 'function', info: 'End a console group', apply: 'console.groupEnd()' },
    { label: 'console.clear', type: 'function', info: 'Clear the console', apply: 'console.clear()' },
    // Window/Document
    { label: 'window', type: 'variable', info: 'Global window object' },
    { label: 'document', type: 'variable', info: 'Document object' },
    { label: 'document.getElementById', type: 'function', info: 'Get element by ID', apply: 'document.getElementById()' },
    { label: 'document.querySelector', type: 'function', info: 'Query selector', apply: 'document.querySelector()' },
    { label: 'document.querySelectorAll', type: 'function', info: 'Query selector all', apply: 'document.querySelectorAll()' },
    { label: 'document.createElement', type: 'function', info: 'Create an element', apply: 'document.createElement()' },
    { label: 'document.body', type: 'property', info: 'Document body element' },
    { label: 'document.head', type: 'property', info: 'Document head element' },
    // DOM methods
    { label: 'addEventListener', type: 'function', info: 'Add event listener' },
    { label: 'removeEventListener', type: 'function', info: 'Remove event listener' },
    { label: 'appendChild', type: 'function', info: 'Append a child element' },
    { label: 'removeChild', type: 'function', info: 'Remove a child element' },
    { label: 'setAttribute', type: 'function', info: 'Set an attribute' },
    { label: 'getAttribute', type: 'function', info: 'Get an attribute' },
    { label: 'classList', type: 'property', info: 'Element class list' },
    { label: 'innerHTML', type: 'property', info: 'Element inner HTML' },
    { label: 'textContent', type: 'property', info: 'Element text content' },
    { label: 'style', type: 'property', info: 'Element style' },
    // Browser APIs
    { label: 'fetch', type: 'function', info: 'Fetch API for HTTP requests', apply: 'fetch()' },
    { label: 'navigator', type: 'variable', info: 'Navigator object' },
    { label: 'location', type: 'variable', info: 'Location object' },
    { label: 'history', type: 'variable', info: 'History object' },
    { label: 'localStorage', type: 'variable', info: 'Local storage' },
    { label: 'sessionStorage', type: 'variable', info: 'Session storage' },
    { label: 'setTimeout', type: 'function', info: 'Set a timeout', apply: 'setTimeout(() => {}, )' },
    { label: 'setInterval', type: 'function', info: 'Set an interval', apply: 'setInterval(() => {}, )' },
    { label: 'clearTimeout', type: 'function', info: 'Clear a timeout', apply: 'clearTimeout()' },
    { label: 'clearInterval', type: 'function', info: 'Clear an interval', apply: 'clearInterval()' },
    { label: 'requestAnimationFrame', type: 'function', info: 'Request animation frame', apply: 'requestAnimationFrame()' },
    // Built-in objects
    { label: 'JSON', type: 'class', info: 'JSON object' },
    { label: 'JSON.parse', type: 'function', info: 'Parse JSON string', apply: 'JSON.parse()' },
    { label: 'JSON.stringify', type: 'function', info: 'Stringify to JSON', apply: 'JSON.stringify()' },
    { label: 'Math', type: 'class', info: 'Math object' },
    { label: 'Math.abs', type: 'function', info: 'Absolute value', apply: 'Math.abs()' },
    { label: 'Math.floor', type: 'function', info: 'Round down', apply: 'Math.floor()' },
    { label: 'Math.ceil', type: 'function', info: 'Round up', apply: 'Math.ceil()' },
    { label: 'Math.round', type: 'function', info: 'Round to nearest', apply: 'Math.round()' },
    { label: 'Math.random', type: 'function', info: 'Random number 0-1', apply: 'Math.random()' },
    { label: 'Math.max', type: 'function', info: 'Maximum value', apply: 'Math.max()' },
    { label: 'Math.min', type: 'function', info: 'Minimum value', apply: 'Math.min()' },
    { label: 'Math.pow', type: 'function', info: 'Power', apply: 'Math.pow()' },
    { label: 'Math.sqrt', type: 'function', info: 'Square root', apply: 'Math.sqrt()' },
    { label: 'Math.PI', type: 'constant', info: 'Pi constant' },
    // Array
    { label: 'Array', type: 'class', info: 'Array constructor' },
    { label: 'Array.from', type: 'function', info: 'Create array from iterable', apply: 'Array.from()' },
    { label: 'Array.isArray', type: 'function', info: 'Check if array', apply: 'Array.isArray()' },
    { label: 'map', type: 'function', info: 'Map array elements' },
    { label: 'filter', type: 'function', info: 'Filter array elements' },
    { label: 'reduce', type: 'function', info: 'Reduce array to single value' },
    { label: 'forEach', type: 'function', info: 'Iterate over array' },
    { label: 'find', type: 'function', info: 'Find element in array' },
    { label: 'findIndex', type: 'function', info: 'Find index in array' },
    { label: 'includes', type: 'function', info: 'Check if array includes value' },
    { label: 'indexOf', type: 'function', info: 'Find index of value' },
    { label: 'push', type: 'function', info: 'Add to end of array' },
    { label: 'pop', type: 'function', info: 'Remove from end of array' },
    { label: 'shift', type: 'function', info: 'Remove from start of array' },
    { label: 'unshift', type: 'function', info: 'Add to start of array' },
    { label: 'slice', type: 'function', info: 'Extract section of array' },
    { label: 'splice', type: 'function', info: 'Change array contents' },
    { label: 'concat', type: 'function', info: 'Concatenate arrays' },
    { label: 'join', type: 'function', info: 'Join array to string' },
    { label: 'sort', type: 'function', info: 'Sort array' },
    { label: 'reverse', type: 'function', info: 'Reverse array' },
    { label: 'every', type: 'function', info: 'Test all elements' },
    { label: 'some', type: 'function', info: 'Test some elements' },
    { label: 'flat', type: 'function', info: 'Flatten array' },
    { label: 'flatMap', type: 'function', info: 'Map and flatten' },
    // Object
    { label: 'Object', type: 'class', info: 'Object constructor' },
    { label: 'Object.keys', type: 'function', info: 'Get object keys', apply: 'Object.keys()' },
    { label: 'Object.values', type: 'function', info: 'Get object values', apply: 'Object.values()' },
    { label: 'Object.entries', type: 'function', info: 'Get object entries', apply: 'Object.entries()' },
    { label: 'Object.assign', type: 'function', info: 'Copy properties', apply: 'Object.assign()' },
    { label: 'Object.freeze', type: 'function', info: 'Freeze object', apply: 'Object.freeze()' },
    { label: 'Object.fromEntries', type: 'function', info: 'Create object from entries', apply: 'Object.fromEntries()' },
    // String
    { label: 'String', type: 'class', info: 'String constructor' },
    { label: 'toLowerCase', type: 'function', info: 'Convert to lowercase' },
    { label: 'toUpperCase', type: 'function', info: 'Convert to uppercase' },
    { label: 'trim', type: 'function', info: 'Trim whitespace' },
    { label: 'split', type: 'function', info: 'Split string' },
    { label: 'replace', type: 'function', info: 'Replace in string' },
    { label: 'replaceAll', type: 'function', info: 'Replace all in string' },
    { label: 'substring', type: 'function', info: 'Extract substring' },
    { label: 'startsWith', type: 'function', info: 'Check string start' },
    { label: 'endsWith', type: 'function', info: 'Check string end' },
    { label: 'padStart', type: 'function', info: 'Pad string start' },
    { label: 'padEnd', type: 'function', info: 'Pad string end' },
    { label: 'charAt', type: 'function', info: 'Get character at index' },
    { label: 'charCodeAt', type: 'function', info: 'Get char code at index' },
    { label: 'length', type: 'property', info: 'Length of string/array' },
    // Promise
    { label: 'Promise', type: 'class', info: 'Promise constructor' },
    { label: 'Promise.all', type: 'function', info: 'Wait for all promises', apply: 'Promise.all()' },

  function updateLanguageUI(lang: string) {
    // Markdown preview button
    if (lang === 'markdown') {
      mdPreviewBtn.classList.remove('hidden');
    } else {
      mdPreviewBtn.classList.add('hidden');
      // Exit preview mode if switching away from markdown
      if (isPreviewMode) {
        isPreviewMode = false;
        markdownPreview.classList.add('hidden');
        editorContainer.classList.remove('hidden');
        mdPreviewBtn.classList.remove('active');
      }
    }
    
    // JSON tools
    if (lang === 'json') {
      jsonTools.classList.remove('hidden');
      scheduleJsonValidation();
    } else {
      jsonTools.classList.add('hidden');
      clearJsonError();
    }
  }


  // Error line highlighting
  const setErrorLine = StateEffect.define<number | null>();
  
  const errorLineField = StateField.define<DecorationSet>({
    create() {
      return Decoration.none;
    },
    update(decorations, tr) {
      for (const effect of tr.effects) {
        if (effect.is(setErrorLine)) {
          if (effect.value === null) {
            return Decoration.none;
          }
          const line = tr.state.doc.line(effect.value);
          const deco = Decoration.line({ class: 'cm-error-line' }).range(line.from);
          return Decoration.set([deco]);
        }
      }
      return decorations;
    },
    provide: f => EditorView.decorations.from(f),
  });

  function showToast(message: string, type: 'success' | 'error' | 'warning' = 'success') {
    toast.textContent = message;
    toast.className = `toast ${type}`;
    setTimeout(() => toast.classList.add('hidden'), 3000);
  }

  function clearJsonError() {
    editor.dispatch({ effects: setErrorLine.of(null) });
  }

  function showJsonError(message: string, line?: number) {
    showToast(message, 'error');
    
    if (line !== undefined && line > 0) {
      const totalLines = editor.state.doc.lines;
      const safeLine = Math.min(line, totalLines);
      editor.dispatch({ effects: setErrorLine.of(safeLine) });
      
      // Scroll to error line
      const lineInfo = editor.state.doc.line(safeLine);
      editor.dispatch({
        selection: { anchor: lineInfo.from },
        scrollIntoView: true,
      });
    }
  }

  function parseJsonError(error: Error): { message: string; line?: number } {
    const match = error.message.match(/at position (\d+)/);
    if (match) {
      const position = parseInt(match[1], 10);
      const content = editor.state.doc.toString();
      const beforeError = content.substring(0, position);
      const line = (beforeError.match(/\n/g) || []).length + 1;
      return { message: `Invalid JSON at line ${line}`, line };
    }
    return { message: 'Invalid JSON' };
  }

  function validateJson(content: string): { valid: boolean; parsed?: any; error?: { message: string; line?: number } } {
    try {
      const parsed = JSON.parse(content);
      return { valid: true, parsed };
    } catch (e) {
      return { valid: false, error: parseJsonError(e as Error) };
    }
  }

  function tryParseJsObject(content: string): { success: boolean; json?: string } {
    // Try to convert JS object literal to JSON
    // This handles cases like { foo: "bar" } -> { "foo": "bar" }
    try {
      // Use Function constructor to safely evaluate (safer than eval)
      // Wrap in parentheses to handle object literals
      const fn = new Function(`return (${content})`);
      const obj = fn();
      if (typeof obj === 'object' && obj !== null) {
        return { success: true, json: JSON.stringify(obj, null, 2) };
      }
    } catch {
      // Silently fail - it's not a valid JS object either
    }
    return { success: false };
  }

  function formatJson() {
    const content = editor.state.doc.toString().trim();
    if (!content) return;

    clearJsonError();
    const result = validateJson(content);
    
    if (result.valid) {
      const formatted = JSON.stringify(result.parsed, null, 2);
      if (formatted !== content) {
        editor.dispatch({
          changes: { from: 0, to: editor.state.doc.length, insert: formatted },
        });
        showToast('JSON formatted');
      }
    } else {
      // Try to parse as JS object
      const jsResult = tryParseJsObject(content);
      if (jsResult.success) {
        editor.dispatch({
          changes: { from: 0, to: editor.state.doc.length, insert: jsResult.json! },
        });
        showToast('Converted JS object to JSON');
      } else {
        showJsonError(result.error!.message, result.error!.line);
      }
    }
  }

  jsonFormatBtn.addEventListener('click', formatJson);

  // Validate JSON on content change (debounced)
  let jsonValidationTimeout: ReturnType<typeof setTimeout>;
  let lastJsObjectWarningShown = 0; // Track when we last showed the JS object warning
  
  function scheduleJsonValidation() {
    clearTimeout(jsonValidationTimeout);
    jsonValidationTimeout = setTimeout(() => {
      if (getSelectedLanguage() !== 'json') return;
      
      const content = editor.state.doc.toString().trim();
      if (!content) {
        clearJsonError();
        return;
      }
      
      const result = validateJson(content);
      if (result.valid) {
        clearJsonError();
      } else {
        // Check if it might be a JS object
        const jsResult = tryParseJsObject(content);
        if (jsResult.success) {
          // Show warning toast (but not too frequently)
          const now = Date.now();
          if (now - lastJsObjectWarningShown > 5000) {
            showToast('JS object detected - click Format to convert', 'warning');
            lastJsObjectWarningShown = now;
          }
          editor.dispatch({ effects: setErrorLine.of(null) });
        } else {
          showJsonError(result.error!.message, result.error!.line);
        }
      }
    }, 500);
  }

  // Auto-format minified JSON on paste
  function handleJsonPaste(content: string): string | null {
    // Check if it looks like minified JSON (no newlines, long line)
    if (!content.includes('\n') && content.length > 50) {
      const result = validateJson(content);
      if (result.valid) {
        return JSON.stringify(result.parsed, null, 2);
      }
    }
    return null;
  }

  // ========================================

  // Custom completion source for language-specific globals
  function createGlobalsCompletionSource(globals: Completion[]) {
    return (context: CompletionContext) => {
      const word = context.matchBefore(/[\w.]+/);
      if (!word || (word.from === word.to && !context.explicit)) return null;
      
      const text = word.text.toLowerCase();
      const filtered = globals.filter(c => c.label.toLowerCase().includes(text));
      
      return {
        from: word.from,
        options: filtered,
        validFor: /^[\w.]*$/,
      };
    };
  }


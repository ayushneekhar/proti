  function getLanguageExtension(lang: string) {
    switch (lang) {
      case 'javascript': return javascript();
      case 'typescript': return javascript({ typescript: true });
      case 'python': return python();
      case 'html': return html();
      case 'css': return css();
      case 'json': return json();
      case 'markdown': return markdown();
      case 'sql': return sql();
      case 'rust': return rust();
      case 'cpp': return cpp();
      case 'java': return java();
      case 'yaml': return yaml();
      case 'go': return javascript(); // Go syntax is similar enough for basic highlighting
      case 'shell': return []; // No specific shell support, fallback to plain
      default: return [];
    }
  }

  // Get completion extension based on language
  function getCompletionExtension(lang: string) {
    switch (lang) {
      case 'javascript':
      case 'typescript':
      case 'html': // HTML often contains JS
        return autocompletion({ override: [jsCompletionSource] });
      case 'python':

        EditorView.contentAttributes.of({ 'aria-label': 'Code editor' }),
        errorLineField,
        // JSON validation on change
        EditorView.updateListener.of((update) => {
          if (update.docChanged && getSelectedLanguage() === 'json') {
            scheduleJsonValidation();
          }
        }),
        // Auto-format minified JSON on paste
        EditorView.domEventHandlers({
          paste(event, view) {
            if (getSelectedLanguage() === 'json') {
              const clipboardData = event.clipboardData;
              if (clipboardData) {
                const text = clipboardData.getData('text/plain');
                const formatted = handleJsonPaste(text);
                if (formatted) {
                  event.preventDefault();
                  const { from, to } = view.state.selection.main;
                  view.dispatch({
                    changes: { from, to, insert: formatted },
                    selection: { anchor: from + formatted.length },
                  });
                  showToast('JSON auto-formatted');
                  return true;
                }
              }
            }
            return false;
          },
        }),
      ],
    }),
    parent: container,
  });

  // Focus editor
  editor.focus();

  // ========================================
  // Fork from existing paste
  // ========================================
  const urlParams = new URLSearchParams(window.location.search);
  const forkId = urlParams.get('fork');
  
  if (forkId) {
    // Load content from existing paste
    fetch(`/api/paste/${forkId}`)
      .then(res => res.json())
      .then(data => {
        if (data.content) {
          editor.dispatch({
            changes: { from: 0, to: editor.state.doc.length, insert: data.content },
          });
          
          // Set language if available
          if (data.language) {
            const label = languageMenu.querySelector(`[data-value="${data.language}"]`)?.textContent || data.language;
            selectLanguage(data.language, label);
          }
          
          showToast('Content loaded - edit and save as new paste');
          
          // Clear the fork parameter from URL
          window.history.replaceState({}, '', '/');
        }
      })
      .catch(() => {
        showToast('Failed to load paste for forking', 'error');
      });
  }

  // Theme change observer
  const themeObserver = new MutationObserver(() => {
    editor.dispatch({
      effects: themeCompartment.reconfigure(isDarkMode() ? darkThemeExtension : lightTheme),
    });
  });
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  // ========================================
  // Options Panel
  // ========================================
  const optionsBtn = document.getElementById('options-btn')!;
  const optionsPanel = document.getElementById('options-panel')!;
  const optionsClose = document.getElementById('options-close')!;
  const burnToggle = document.getElementById('burn-toggle') as HTMLInputElement;
  const passwordToggle = document.getElementById('password-toggle') as HTMLInputElement;
  const passwordInput = document.getElementById('password-input') as HTMLInputElement;
  const expirationBtns = document.querySelectorAll('.expiration-btn');
  
  let selectedExpiration = '30d';
  
  // Open options panel
  optionsBtn.addEventListener('click', () => {
    optionsPanel.classList.remove('hidden');
    optionsBtn.classList.add('active');
  });
  
  // Close options panel with X button
  optionsClose.addEventListener('click', () => {
    optionsPanel.classList.add('hidden');
    optionsBtn.classList.remove('active');
  });
  
  // Expiration selection
  expirationBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      expirationBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      selectedExpiration = (btn as HTMLElement).dataset.value || '30d';
    });
  });
  
  // Password toggle
  passwordToggle.addEventListener('change', () => {
    if (passwordToggle.checked) {
      passwordInput.classList.remove('hidden');
      passwordInput.focus();
    } else {
      passwordInput.classList.add('hidden');
      passwordInput.value = '';
    }
  });

  // ========================================
  // Drag & Drop File Upload
  // ========================================
  const dropOverlay = document.getElementById('drop-overlay')!;
  const pasteApp = document.querySelector('.paste-app')!;
  let dragCounter = 0;
  
  pasteApp.addEventListener('dragenter', (e) => {
    e.preventDefault();
    dragCounter++;
    if (dragCounter === 1) {
      dropOverlay.classList.remove('hidden');
    }
  });
  
  pasteApp.addEventListener('dragleave', (e) => {
    e.preventDefault();
    dragCounter--;
    if (dragCounter === 0) {
      dropOverlay.classList.add('hidden');
    }
  });
  
  pasteApp.addEventListener('dragover', (e) => {
    e.preventDefault();
  });
  
  pasteApp.addEventListener('drop', async (e) => {
    e.preventDefault();
    dragCounter = 0;
    dropOverlay.classList.add('hidden');
    
    const files = e.dataTransfer?.files;
    if (files && files.length > 0) {
      const file = files[0];
      
      // Check file size (max 500KB)
      if (file.size > 500000) {
        showToast('File too large (max 500KB)', 'error');
        return;
      }
      
      // Read file content
      const text = await file.type.startsWith('text/') || isTextFile(file.name)
        ? await file.text()
        : null;
      
      if (text !== null) {
        editor.dispatch({
          changes: { from: 0, to: editor.state.doc.length, insert: text },
        });
        
        // Try to detect language from file extension
        const ext = file.name.split('.').pop()?.toLowerCase();
        const langMap: Record<string, string> = {
          'js': 'javascript',
          'mjs': 'javascript',
          'jsx': 'javascript',
          'ts': 'typescript',
          'tsx': 'typescript',
          'py': 'python',
          'rs': 'rust',
          'go': 'go',
          'html': 'html',
          'htm': 'html',
          'css': 'css',
          'json': 'json',
          'md': 'markdown',
          'markdown': 'markdown',
          'sql': 'sql',
          'sh': 'shell',
          'bash': 'shell',
          'zsh': 'shell',
          'yaml': 'yaml',
          'yml': 'yaml',
          'cpp': 'cpp',
          'cc': 'cpp',
          'c': 'cpp',
          'h': 'cpp',
          'hpp': 'cpp',
          'java': 'java',
          'txt': 'plaintext',
        };
        
        if (ext && langMap[ext]) {
          const lang = langMap[ext];
          const label = languageMenu.querySelector(`[data-value="${lang}"]`)?.textContent || lang;
          selectLanguage(lang, label);
        }
        
        showToast(`Loaded ${file.name}`);
        editor.focus();
      } else {
        showToast('Cannot read file type', 'error');
      }
    }
  });
  
  function isTextFile(filename: string): boolean {
    const textExtensions = ['js', 'mjs', 'jsx', 'ts', 'tsx', 'py', 'rs', 'go', 'html', 'htm', 
      'css', 'json', 'md', 'markdown', 'sql', 'sh', 'bash', 'zsh', 'yaml', 'yml', 
      'cpp', 'cc', 'c', 'h', 'hpp', 'java', 'txt', 'xml', 'svg', 'toml', 'ini', 'cfg',
      'env', 'gitignore', 'dockerignore', 'editorconfig', 'astro', 'vue', 'svelte'];
    const ext = filename.split('.').pop()?.toLowerCase() || '';
    return textExtensions.includes(ext);
  }

  // Save handler
  saveBtn.addEventListener('click', async () => {
    const content = editor.state.doc.toString().trim();
    if (!content) {
      showToast('Please enter some content', 'error');
      return;
    }

    // Validate password if enabled
    if (passwordToggle.checked && !passwordInput.value.trim()) {
      showToast('Please enter a password', 'error');
      passwordInput.focus();
      return;
    }

    saveBtn.disabled = true;
    const btnText = saveBtn.querySelector('.btn-text');
    if (btnText) btnText.textContent = 'Saving...';

    try {
      const response = await fetch('/api/paste', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          content,
          language: getSelectedLanguage(),
          expiration: selectedExpiration,
          burnAfterReading: burnToggle.checked,
          password: passwordToggle.checked ? passwordInput.value : null,
        }),
      });

      if (!response.ok) {
        throw new Error('Failed to save paste');
      }

      const data = await response.json();
      window.location.href = data.url || `/${data.id}`;
    } catch (error) {
      showToast('Failed to save paste', 'error');
      saveBtn.disabled = false;
      if (btnText) btnText.textContent = 'Save';
    }
  });

  // Keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    // Ctrl/Cmd+S to save
    if ((e.ctrlKey || e.metaKey) && e.key === 's') {
      e.preventDefault();
      saveBtn.click();
    }
    // Ctrl/Cmd+N for new paste (clear editor)
    if ((e.ctrlKey || e.metaKey) && e.key === 'n') {
      e.preventDefault();
      // Clear editor and reset options
      editor.dispatch({
        changes: { from: 0, to: editor.state.doc.length, insert: '' },
      });
      selectLanguage('javascript', 'JavaScript');
      selectedExpiration = '30d';
      expirationBtns.forEach(btn => {
        btn.classList.toggle('active', (btn as HTMLElement).dataset.value === '30d');
      });
      burnToggle.checked = false;
      passwordToggle.checked = false;
      passwordInput.classList.add('hidden');
      passwordInput.value = '';
      optionsPanel.classList.add('hidden');
      optionsBtn.classList.remove('active');
      editor.focus();
      showToast('New paste');
    }
  });

  // About modal
  const aboutBtn = document.getElementById('about-btn');
  const aboutModal = document.getElementById('about-modal');
  const aboutClose = document.getElementById('about-close');

  aboutBtn?.addEventListener('click', () => {
    aboutModal?.classList.remove('hidden');
  });

  aboutClose?.addEventListener('click', () => {
    aboutModal?.classList.add('hidden');
  });

  aboutModal?.addEventListener('click', (e) => {
    if (e.target === aboutModal) {
      aboutModal.classList.add('hidden');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && aboutModal && !aboutModal.classList.contains('hidden')) {
      aboutModal.classList.add('hidden');
    }
  });
</script>


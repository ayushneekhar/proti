---
import Layout from '../../layouts/Layout.astro';
import { createHighlighter } from 'shiki';
import { marked } from 'marked';
import QRCode from 'qrcode';

interface PasteData {
  content: string;
  language: string;
  createdAt: string;
  expiresAt?: string;
  burnAfterReading?: boolean;
  passwordHash?: string;
}

const { id } = Astro.params;

// Fetch paste data from KV
let paste: PasteData | null = null;
let error: string | null = null;
let highlightedLines: string[] = [];
let renderedMarkdown: string = '';
let requiresPassword = false;
let wasBurned = false;
let qrCodeDataUrl: string = '';

try {
  const { env } = Astro.locals.runtime;
  const data = await env.PASTE_STORE.get(id);
  
  if (data) {
    paste = JSON.parse(data);
    
    // Check if password protected
    if (paste.passwordHash) {
      requiresPassword = true;
      // Don't process content - will be handled client-side
    } else {
      // If burn after reading, delete now
      if (paste.burnAfterReading) {
        await env.PASTE_STORE.delete(id);
        wasBurned = true;
      }
      
      // If it's markdown, render it
      if (paste.language === 'markdown') {
        renderedMarkdown = await marked.parse(paste.content, {
          breaks: true,
          gfm: true,
        });
      }
      
      // Map language names to Shiki language identifiers
      const languageMap: Record<string, string> = {
        'plaintext': 'text',
        'javascript': 'javascript',
        'typescript': 'typescript',
        'python': 'python',
        'rust': 'rust',
        'go': 'go',
        'html': 'html',
        'css': 'css',
        'json': 'json',
        'markdown': 'markdown',
        'sql': 'sql',
        'shell': 'bash',
        'yaml': 'yaml',
        'cpp': 'cpp',
        'java': 'java',
      };

      const shikiLang = languageMap[paste.language] || 'text';
      
      try {
        const highlighter = await createHighlighter({
          themes: ['github-light', 'github-dark'],
          langs: [shikiLang],
        });

        const tokens = highlighter.codeToTokensWithThemes(paste.content, {
          lang: shikiLang,
          themes: {
            light: 'github-light',
            dark: 'github-dark',
          },
        });

        // Build highlighted lines
        highlightedLines = tokens.map(lineTokens => {
          return lineTokens.map(token => {
            const lightColor = token.variants?.light || token.color || '';
            const darkColor = token.variants?.dark || token.color || '';
            return `<span style="--shiki-light:${lightColor};--shiki-dark:${darkColor}">${escapeHtml(token.content)}</span>`;
          }).join('');
        });
      } catch (e) {
        // Fallback to plain text if highlighting fails
        highlightedLines = paste.content.split('\n').map(line => escapeHtml(line));
      }
    }
    
    // Generate QR code
    const shareUrl = `https://neekhar.dev/paste/${id}`;
    try {
      qrCodeDataUrl = await QRCode.toDataURL(shareUrl, {
        width: 200,
        margin: 2,
        color: {
          dark: '#000000',
          light: '#ffffff',
        },
      });
    } catch (e) {
      // QR code generation failed, not critical
    }
  } else {
    error = 'Paste not found or has expired';
  }
} catch (e) {
  error = 'Failed to load paste';
}

function escapeHtml(text: string): string {
  return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

// Calculate time remaining
const getTimeRemaining = (expiresAt?: string, createdAt?: string) => {
  if (!expiresAt && !createdAt) return 'Unknown';
  
  const expires = expiresAt 
    ? new Date(expiresAt) 
    : new Date(new Date(createdAt!).getTime() + 30 * 24 * 60 * 60 * 1000);
  const now = new Date();
  const diffMs = expires.getTime() - now.getTime();
  
  if (diffMs <= 0) return 'Expired';
  
  const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
  const diffDays = Math.floor(diffHours / 24);
  
  if (diffDays > 0) return `${diffDays}d left`;
  if (diffHours > 0) return `${diffHours}h left`;
  return '< 1h left';
};

const timeRemaining = paste ? getTimeRemaining(paste.expiresAt, paste.createdAt) : '';
const shareUrl = `https://neekhar.dev/paste/${id}`;
const lineCount = highlightedLines.length || 1;
const isMarkdown = paste?.language === 'markdown';

// File extension map
const extMap: Record<string, string> = {
  'javascript': 'js',
  'typescript': 'ts',
  'python': 'py',
  'rust': 'rs',
  'go': 'go',
  'html': 'html',
  'css': 'css',
  'json': 'json',
  'markdown': 'md',
  'sql': 'sql',
  'shell': 'sh',
  'yaml': 'yml',
  'cpp': 'cpp',
  'java': 'java',
  'plaintext': 'txt',
};
const fileExt = paste ? (extMap[paste.language] || 'txt') : 'txt';

// Generate description for OG tags
const ogDescription = paste 
  ? `${paste.language.charAt(0).toUpperCase() + paste.language.slice(1)} code snippet (${lineCount} lines) - View and copy this paste on neekhar.dev`
  : 'Paste not found';
---

<Layout 
  title={paste ? `Paste ${id} | Ayush Neekhar` : 'Paste Not Found'}
  description={ogDescription}
  ogUrl={shareUrl}
>
  <div class="paste-app">
    <header class="toolbar">
      <div class="toolbar-left">
        <a href="/" class="brand">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span>neekhar.dev</span>
        </a>
        <span class="separator">/</span>
        <a href="/paste" class="nav-link">paste</a>
        {paste && (
          <>
            <span class="separator">/</span>
            <span class="paste-id">{id}</span>
          </>
        )}
      </div>
      <div class="toolbar-right">
        {paste && !requiresPassword && (
          <>
            {wasBurned && <span class="burn-badge">🔥 Burned</span>}
            <span class="expiry-badge">{timeRemaining}</span>
            <span class="language-badge">{paste.language}</span>
          </>
        )}
        {isMarkdown && !requiresPassword && (
          <button id="md-view-toggle" class="toolbar-btn with-tooltip active" data-tooltip="View raw">
            <svg class="icon-raw" viewBox="0 0 24 24" aria-hidden="true">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
            <svg class="icon-rendered" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
        )}
        <button class="theme-toggle" type="button" aria-label="Toggle color theme">
          <svg class="icon icon--sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <line x1="12" y1="2" x2="12" y2="4"></line>
            <line x1="12" y1="20" x2="12" y2="22"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="2" y1="12" x2="4" y2="12"></line>
            <line x1="20" y1="12" x2="22" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg class="icon icon--moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 12.79A9 9 0 0111.21 3 7 7 0 1021 12.79z"></path>
          </svg>
        </button>
        {paste && !requiresPassword && (
          <>
            <button id="copy-code-btn" class="toolbar-btn with-tooltip" data-content={paste.content} data-tooltip="Copy code">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
              </svg>
            </button>
            <button id="copy-url-btn" class="toolbar-btn with-tooltip" data-url={shareUrl} data-tooltip="Copy URL">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"></path>
              </svg>
            </button>
            <button id="download-btn" class="toolbar-btn with-tooltip" data-content={paste.content} data-filename={`paste-${id}.${fileExt}`} data-tooltip="Download file">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </button>
            <button id="qr-btn" class="toolbar-btn with-tooltip" data-tooltip="Show QR code">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
                <rect x="14" y="14" width="3" height="3"></rect>
                <rect x="18" y="14" width="3" height="3"></rect>
                <rect x="14" y="18" width="3" height="3"></rect>
                <rect x="18" y="18" width="3" height="3"></rect>
              </svg>
            </button>
            <a href={`/paste?fork=${id}`} class="toolbar-btn with-tooltip" data-tooltip="Fork & edit">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"></path>
              </svg>
            </a>
            <a href="/paste" class="new-btn with-tooltip" data-tooltip="Create new paste">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span class="btn-text">New</span>
            </a>
          </>
        )}
      </div>
    </header>

    {error ? (
      <div class="error-container">
        <h2>Paste Not Found</h2>
        <p>{error}</p>
        <a href="/paste" class="new-paste-btn">Create New Paste</a>
      </div>
    ) : requiresPassword ? (
      <!-- Password Protected Paste -->
      <div class="password-container">
        <div class="password-card">
          <svg class="lock-icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0110 0v4"></path>
          </svg>
          <h2>Password Protected</h2>
          <p>This paste requires a password to view.</p>
          <form id="password-form" class="password-form">
            <input 
              type="password" 
              id="paste-password" 
              class="password-input" 
              placeholder="Enter password"
              autocomplete="current-password"
              required
            />
            <button type="submit" class="unlock-btn">
              <span>Unlock</span>
            </button>
          </form>
          <p id="password-error" class="password-error hidden">Invalid password</p>
        </div>
      </div>
    ) : paste && (
      <>
        {wasBurned && (
          <div class="burn-banner">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"></path>
            </svg>
            <span>This paste has been destroyed after viewing. Save it now if you need it!</span>
          </div>
        )}
        {isMarkdown && (
          <div id="markdown-preview" class="markdown-preview" set:html={renderedMarkdown} />
        )}
        <div id="code-container" class={`code-container ${isMarkdown ? 'hidden' : ''}`}>
          <div class="line-numbers" id="line-numbers">
            {Array.from({ length: lineCount }, (_, i) => (
              <a href={`#L${i + 1}`} class="line-number" data-line={i + 1}>{i + 1}</a>
            ))}
          </div>
          <pre class="code-content"><code>{highlightedLines.map((line, i) => (
            <span class="code-line" id={`L${i + 1}`} data-line={i + 1} set:html={line || ' '} />
          ))}</code></pre>
        </div>
      </>
    )}
    
    <!-- QR Code Modal -->
    <div id="qr-modal" class="qr-modal hidden">
      <div class="qr-modal-content">
        <button id="qr-close" class="qr-close" aria-label="Close">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
        <h3>Scan to open</h3>
        {qrCodeDataUrl && <img src={qrCodeDataUrl} alt="QR Code" class="qr-image" />}
        <p class="qr-url">{shareUrl}</p>
      </div>
    </div>
    
    <!-- Toast -->
    <div id="toast" class="toast hidden"></div>
  </div>
</Layout>

<script>
  const copyCodeBtn = document.getElementById('copy-code-btn');
  const copyUrlBtn = document.getElementById('copy-url-btn');
  const downloadBtn = document.getElementById('download-btn');
  const qrBtn = document.getElementById('qr-btn');
  const qrModal = document.getElementById('qr-modal');
  const qrClose = document.getElementById('qr-close');
  const mdViewToggle = document.getElementById('md-view-toggle');
  const markdownPreview = document.getElementById('markdown-preview');
  const codeContainer = document.getElementById('code-container');
  const lineNumbers = document.getElementById('line-numbers');
  const toast = document.getElementById('toast');
  const passwordForm = document.getElementById('password-form');
  const passwordError = document.getElementById('password-error');

  function showToast(message: string, type: 'success' | 'error' = 'success') {
    if (!toast) return;
    toast.textContent = message;
    toast.className = `toast ${type}`;
    setTimeout(() => toast.classList.add('hidden'), 2500);
  }

  async function copyWithFeedback(btn: HTMLElement, text: string) {
    await navigator.clipboard.writeText(text);
    btn.classList.add('copied');
    const originalTooltip = btn.getAttribute('data-tooltip');
    btn.setAttribute('data-tooltip', 'Copied!');
    showToast('Copied to clipboard');
    setTimeout(() => {
      btn.classList.remove('copied');
      btn.setAttribute('data-tooltip', originalTooltip || '');
    }, 1500);
  }

  // Copy buttons
  copyCodeBtn?.addEventListener('click', () => {
    const content = copyCodeBtn.getAttribute('data-content');
    if (content) copyWithFeedback(copyCodeBtn, content);
  });

  copyUrlBtn?.addEventListener('click', () => {
    const url = copyUrlBtn.getAttribute('data-url');
    if (url) copyWithFeedback(copyUrlBtn, url);
  });

  // Download button
  downloadBtn?.addEventListener('click', () => {
    const content = downloadBtn.getAttribute('data-content');
    const filename = downloadBtn.getAttribute('data-filename') || 'paste.txt';
    
    if (content) {
      const blob = new Blob([content], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast(`Downloaded ${filename}`);
    }
  });

  // QR Code modal
  qrBtn?.addEventListener('click', () => {
    qrModal?.classList.remove('hidden');
  });

  qrClose?.addEventListener('click', () => {
    qrModal?.classList.add('hidden');
  });

  qrModal?.addEventListener('click', (e) => {
    if (e.target === qrModal) {
      qrModal.classList.add('hidden');
    }
  });

  // Close modal on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && qrModal && !qrModal.classList.contains('hidden')) {
      qrModal.classList.add('hidden');
    }
  });

  // Markdown view toggle
  if (mdViewToggle && markdownPreview && codeContainer) {
    let showingRendered = true;
    
    mdViewToggle.addEventListener('click', () => {
      showingRendered = !showingRendered;
      
      if (showingRendered) {
        markdownPreview.classList.remove('hidden');
        codeContainer.classList.add('hidden');
        mdViewToggle.classList.add('active');
        mdViewToggle.setAttribute('data-tooltip', 'View raw');
      } else {
        markdownPreview.classList.add('hidden');
        codeContainer.classList.remove('hidden');
        mdViewToggle.classList.remove('active');
        mdViewToggle.setAttribute('data-tooltip', 'View rendered');
      }
    });
  }

  // ========================================
  // Line Linking
  // ========================================
  let selectedLines: { start: number; end: number } | null = null;
  
  function clearLineHighlights() {
    document.querySelectorAll('.code-line.highlighted').forEach(el => {
      el.classList.remove('highlighted');
    });
    document.querySelectorAll('.line-number.highlighted').forEach(el => {
      el.classList.remove('highlighted');
    });
  }
  
  function highlightLines(start: number, end: number) {
    clearLineHighlights();
    
    for (let i = start; i <= end; i++) {
      const line = document.getElementById(`L${i}`);
      const lineNum = document.querySelector(`.line-number[data-line="${i}"]`);
      if (line) line.classList.add('highlighted');
      if (lineNum) lineNum.classList.add('highlighted');
    }
    
    selectedLines = { start, end };
    
    // Update URL hash without scrolling
    const hash = start === end ? `#L${start}` : `#L${start}-L${end}`;
    history.replaceState(null, '', hash);
  }
  
  function scrollToLine(line: number) {
    const el = document.getElementById(`L${line}`);
    if (el) {
      el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }
  
  // Parse URL hash on load
  function parseHashAndHighlight() {
    const hash = window.location.hash;
    if (!hash) return;
    
    // Match #L10 or #L10-L20
    const match = hash.match(/^#L(\d+)(?:-L(\d+))?$/);
    if (match) {
      const start = parseInt(match[1], 10);
      const end = match[2] ? parseInt(match[2], 10) : start;
      highlightLines(Math.min(start, end), Math.max(start, end));
      scrollToLine(start);
    }
  }
  
  // Line number click handling
  lineNumbers?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.classList.contains('line-number')) return;
    
    e.preventDefault();
    const clickedLine = parseInt(target.dataset.line || '1', 10);
    
    if (e.shiftKey && selectedLines) {
      // Shift+click for range selection
      const start = Math.min(selectedLines.start, clickedLine);
      const end = Math.max(selectedLines.start, clickedLine);
      highlightLines(start, end);
    } else {
      // Single click
      highlightLines(clickedLine, clickedLine);
    }
  });
  
  // Initialize line highlighting from URL
  parseHashAndHighlight();
  
  // Handle hash changes
  window.addEventListener('hashchange', parseHashAndHighlight);

  // ========================================
  // Password Form
  // ========================================
  passwordForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const passwordInput = document.getElementById('paste-password') as HTMLInputElement;
    const password = passwordInput?.value;
    
    if (!password) return;
    
    const submitBtn = passwordForm.querySelector('button[type="submit"]');
    if (submitBtn) submitBtn.textContent = 'Unlocking...';
    
    try {
      const pasteId = window.location.pathname.split('/').pop();
      const response = await fetch(`/api/paste/${pasteId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password }),
      });
      
      if (response.ok) {
        // Password correct - reload page (paste will be deleted if burn after reading)
        window.location.reload();
      } else {
        passwordError?.classList.remove('hidden');
        if (submitBtn) submitBtn.textContent = 'Unlock';
        passwordInput.value = '';
        passwordInput.focus();
      }
    } catch (error) {
      passwordError?.classList.remove('hidden');
      if (submitBtn) submitBtn.textContent = 'Unlock';
    }
  });
</script>

<style>
  .paste-app {
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
  }

  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 16px;
    height: 48px;
    min-height: 48px;
    background-color: var(--surface);
    border-bottom: 1px solid var(--outline);
    gap: 12px;
  }

  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .brand:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .brand svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }

  .separator {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .nav-link {
    font-size: 0.85rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .paste-id {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text);
  }

  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .language-badge {
    font-size: 0.75rem;
    padding: 3px 8px;
    background-color: var(--accent);
    color: var(--bg);
    border-radius: 4px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .expiry-badge {
    font-size: 0.75rem;
    padding: 3px 8px;
    background-color: var(--surface-tint);
    color: var(--muted);
    border: 1px solid var(--outline);
    border-radius: 4px;
  }

  .toolbar-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    font-family: var(--font-family);
    color: var(--text);
    background-color: var(--surface-tint);
    border: 1px solid var(--outline);
    border-radius: 6px;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .toolbar-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .toolbar-btn.active {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .toolbar-btn.copied {
    border-color: #22c55e;
    color: #22c55e;
  }

  .toolbar-btn svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }

  /* Markdown view toggle icons */
  #md-view-toggle .icon-rendered {
